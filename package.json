{
  "name": "ort-engine",
  "version": "1.1.0",
  "description": "ORT Engine - Ghostfish Slot Manager",
  "main": "main.js",
  "homepage": "https://github.com/vicentemunoz3323-max/ort-engine",
  "repository": {
    "type": "git",
    "url": "https://github.com/vicentemunoz3323-max/ort-engine.git"
  },
  "scripts": {
    "start": "electron .",
    "build:deb": "electron-builder --linux deb",
    "release": "electron-builder --linux deb --publish always"
  },
  "keywords": [
    "ort",
    "ghostfish",
    "electron"
  ],
  "author": "Vicente Muñoz <vicentemunoz3323@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.vicente.ortengine",
    "productName": "ORTEngine",
    "directories": {
      "output": "dist"
    },
    "linux": {
      "target": [
        "deb"
      ],
      "category": "Utility",
      "maintainer": "Vicente Muñoz <vicentemunoz3323@gmail.com>",
      "icon": "icons"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "vicentemunoz3323-max",
        "repo": "ort-engine",
        "releaseType": "release"
      }
    ]
  }
}
